<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}StarHosting{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style>
        [x-cloak] { display: none !important; }
        .nav-link { @apply flex items-center gap-3 px-4 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-700 transition-all duration-150 text-sm font-medium; }
        .nav-link.active { @apply bg-indigo-600 text-white; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="h-full bg-slate-900 font-sans antialiased">

<div class="flex h-full min-h-screen" x-data="{ sidebarOpen: false }">

    {# Mobile overlay #}
    <div x-show="sidebarOpen" x-cloak class="fixed inset-0 z-20 bg-black/60 lg:hidden" @click="sidebarOpen = false"></div>

    {# Sidebar #}
    <aside class="fixed inset-y-0 left-0 z-30 w-64 flex flex-col bg-slate-800 border-r border-slate-700 transform transition-transform duration-200 ease-in-out lg:translate-x-0 lg:static lg:inset-0"
           :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'">

        {# Logo #}
        <div class="flex items-center gap-3 px-6 py-5 border-b border-slate-700">
            <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-indigo-600">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
                </svg>
            </div>
            <div>
                <p class="text-white font-semibold text-sm leading-tight">StarHosting</p>
                <p class="text-slate-400 text-xs">Control Panel</p>
            </div>
        </div>

        {# Navigation #}
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
            <p class="px-4 py-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">Main</p>

            <a href="{{ path('app_dashboard') }}"
               class="nav-link {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'active' : '' }}">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
                Dashboard
            </a>

            <p class="px-4 pt-4 pb-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">Hosting</p>

            <a href="{{ path('app_sites_index') }}"
               class="nav-link {{ app.request.attributes.get('_route') starts with 'app_sites' ? 'active' : '' }}">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                </svg>
                Sites
            </a>

            <a href="{{ path('app_mail_index') }}"
               class="nav-link {{ app.request.attributes.get('_route') starts with 'app_mail' ? 'active' : '' }}">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                Mail
            </a>

            <p class="px-4 pt-4 pb-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">System</p>

            <a href="{{ path('app_dashboard') }}"
               class="nav-link">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                Settings
            </a>
        </nav>

        {# Version badge #}
        <div class="px-4 py-3 border-t border-slate-700">
            <p class="text-xs text-slate-500 text-center">StarHosting v1.0.0</p>
        </div>
    </aside>

    {# Main area #}
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">

        {# Top bar #}
        <header class="flex items-center justify-between h-16 px-4 lg:px-6 bg-slate-800 border-b border-slate-700 flex-shrink-0">
            <div class="flex items-center gap-3">
                {# Mobile hamburger #}
                <button class="lg:hidden p-2 rounded-md text-slate-400 hover:text-white hover:bg-slate-700"
                        @click="sidebarOpen = !sidebarOpen">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
                <h1 class="text-white font-semibold text-base">{% block page_title %}{% endblock %}</h1>
            </div>

            <div class="flex items-center gap-3" x-data="{ userMenu: false }">
                <div class="relative">
                    <button @click="userMenu = !userMenu"
                            class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-700 transition-colors text-sm">
                        <div class="w-7 h-7 rounded-full bg-indigo-600 flex items-center justify-center text-white text-xs font-semibold">
                            {{ app.user ? app.user.email|first|upper : '?' }}
                        </div>
                        <span class="hidden sm:block max-w-[140px] truncate">{{ app.user ? app.user.email : '' }}</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>

                    <div x-show="userMenu" x-cloak @click.outside="userMenu = false"
                         class="absolute right-0 mt-2 w-48 bg-slate-800 border border-slate-700 rounded-lg shadow-xl z-50 py-1">
                        <div class="px-4 py-2 border-b border-slate-700">
                            <p class="text-xs text-slate-400">Signed in as</p>
                            <p class="text-sm text-white font-medium truncate">{{ app.user ? app.user.email : '' }}</p>
                        </div>
                        <a href="{{ path('app_logout') }}"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-slate-300 hover:text-white hover:bg-slate-700 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                            </svg>
                            Sign out
                        </a>
                    </div>
                </div>
            </div>
        </header>

        {# Flash messages #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div x-data="{ show: true }" x-show="show" x-cloak
                     x-init="setTimeout(() => show = false, 5000)"
                     class="mx-4 lg:mx-6 mt-4 flex items-start gap-3 px-4 py-3 rounded-lg border text-sm
                     {% if type == 'success' %}bg-emerald-900/50 border-emerald-700 text-emerald-300
                     {% elseif type == 'error' %}bg-red-900/50 border-red-700 text-red-300
                     {% elseif type == 'warning' %}bg-amber-900/50 border-amber-700 text-amber-300
                     {% else %}bg-blue-900/50 border-blue-700 text-blue-300{% endif %}">
                    <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        {% if type == 'success' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        {% elseif type == 'error' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        {% elseif type == 'warning' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        {% else %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        {% endif %}
                    </svg>
                    <span>{{ message }}</span>
                    <button @click="show = false" class="ml-auto flex-shrink-0 opacity-70 hover:opacity-100">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
            {% endfor %}
        {% endfor %}

        {# Page content #}
        <main class="flex-1 overflow-y-auto p-4 lg:p-6">
            {% block content %}{% endblock %}
        </main>
    </div>
</div>

{% block javascripts %}{% endblock %}
</body>
</html>
