{% extends 'base.html.twig' %}

{% block title %}Dashboard — StarHosting{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block content %}

{# Welcome row #}
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h2 class="text-xl font-bold text-white">Welcome back 👋</h2>
        <p class="text-slate-400 text-sm mt-0.5">Here's what's happening with your server.</p>
    </div>
    <div class="flex items-center gap-2">
        <span class="flex items-center gap-1.5 px-3 py-1.5 bg-emerald-900/50 border border-emerald-700 rounded-full text-emerald-400 text-xs font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            System Online
        </span>
    </div>
</div>

{# System stats cards #}
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">

    {# CPU Card #}
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
                <div class="w-9 h-9 rounded-lg bg-violet-600/20 flex items-center justify-center">
                    <svg class="w-5 h-5 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 3H7a2 2 0 00-2 2v2M9 3h6M9 3v2m6-2h2a2 2 0 012 2v2m0 0V5m0 4v6m0 4v2a2 2 0 01-2 2h-2m0 0H9m6 0v-2M9 21H7a2 2 0 01-2-2v-2m0 0V9m0 6H5m4 4v-2m0-8V7m0 2H7m2 0h6m0 0h2m-2 0v8m-6-8v8"/>
                    </svg>
                </div>
                <span class="text-slate-300 text-sm font-medium">CPU Load</span>
            </div>
            <span class="text-2xl font-bold text-white">{{ stats.cpu.usage }}%</span>
        </div>
        <div class="w-full bg-slate-700 rounded-full h-2">
            <div class="h-2 rounded-full transition-all duration-500
                {% if stats.cpu.usage < 60 %}bg-violet-500{% elseif stats.cpu.usage < 85 %}bg-amber-500{% else %}bg-red-500{% endif %}"
                 style="width: {{ stats.cpu.usage }}%"></div>
        </div>
        <p class="text-slate-500 text-xs mt-2">1-min load avg: {{ stats.cpu.load }}</p>
    </div>

    {# RAM Card #}
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
                <div class="w-9 h-9 rounded-lg bg-indigo-600/20 flex items-center justify-center">
                    <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                </div>
                <span class="text-slate-300 text-sm font-medium">Memory</span>
            </div>
            <span class="text-2xl font-bold text-white">{{ stats.ram.percent }}%</span>
        </div>
        <div class="w-full bg-slate-700 rounded-full h-2">
            <div class="h-2 rounded-full transition-all duration-500
                {% if stats.ram.percent < 70 %}bg-indigo-500{% elseif stats.ram.percent < 85 %}bg-amber-500{% else %}bg-red-500{% endif %}"
                 style="width: {{ stats.ram.percent }}%"></div>
        </div>
        <p class="text-slate-500 text-xs mt-2">{{ stats.ram.used }} GB / {{ stats.ram.total }} GB used</p>
    </div>

    {# Disk Card #}
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
                <div class="w-9 h-9 rounded-lg bg-cyan-600/20 flex items-center justify-center">
                    <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/>
                    </svg>
                </div>
                <span class="text-slate-300 text-sm font-medium">Disk Usage</span>
            </div>
            <span class="text-2xl font-bold text-white">{{ stats.disk.percent }}%</span>
        </div>
        <div class="w-full bg-slate-700 rounded-full h-2">
            <div class="h-2 rounded-full transition-all duration-500
                {% if stats.disk.percent < 70 %}bg-cyan-500{% elseif stats.disk.percent < 85 %}bg-amber-500{% else %}bg-red-500{% endif %}"
                 style="width: {{ stats.disk.percent }}%"></div>
        </div>
        <p class="text-slate-500 text-xs mt-2">{{ stats.disk.used }} GB / {{ stats.disk.total }} GB used</p>
    </div>
</div>

{# Overview cards row #}
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">

    {# Quick stats #}
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
        <h3 class="text-white font-semibold text-sm mb-4 flex items-center gap-2">
            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            Overview
        </h3>
        <div class="space-y-3">
            <div class="flex items-center justify-between py-2 border-b border-slate-700">
                <span class="text-slate-400 text-sm">Active Sites</span>
                <span class="text-white font-semibold">{{ sites_count }}</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-slate-700">
                <span class="text-slate-400 text-sm">Mail Accounts</span>
                <span class="text-white font-semibold">{{ mail_count }}</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-slate-700">
                <span class="text-slate-400 text-sm">Web Server</span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-900/60 text-indigo-300 border border-indigo-700">
                    {{ webserver|upper }}
                </span>
            </div>
            <div class="flex items-center justify-between py-2">
                <span class="text-slate-400 text-sm">Database</span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-900/60 text-emerald-300 border border-emerald-700">
                    {{ database|upper }}
                </span>
            </div>
        </div>
    </div>

    {# Quick actions #}
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
        <h3 class="text-white font-semibold text-sm mb-4 flex items-center gap-2">
            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            Quick Actions
        </h3>
        <div class="grid grid-cols-2 gap-3">
            <a href="{{ path('app_sites_create') }}"
               class="flex flex-col items-center gap-2 p-4 bg-slate-700/50 hover:bg-slate-700 border border-slate-600 hover:border-indigo-600 rounded-xl transition-all group">
                <div class="w-10 h-10 rounded-lg bg-indigo-600/20 group-hover:bg-indigo-600/40 flex items-center justify-center transition-colors">
                    <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                </div>
                <span class="text-slate-300 text-xs font-medium text-center">New Site</span>
            </a>
            <a href="{{ path('app_mail_account_create') }}"
               class="flex flex-col items-center gap-2 p-4 bg-slate-700/50 hover:bg-slate-700 border border-slate-600 hover:border-emerald-600 rounded-xl transition-all group">
                <div class="w-10 h-10 rounded-lg bg-emerald-600/20 group-hover:bg-emerald-600/40 flex items-center justify-center transition-colors">
                    <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                </div>
                <span class="text-slate-300 text-xs font-medium text-center">New Mailbox</span>
            </a>
            <a href="{{ path('app_sites_index') }}"
               class="flex flex-col items-center gap-2 p-4 bg-slate-700/50 hover:bg-slate-700 border border-slate-600 hover:border-violet-600 rounded-xl transition-all group">
                <div class="w-10 h-10 rounded-lg bg-violet-600/20 group-hover:bg-violet-600/40 flex items-center justify-center transition-colors">
                    <svg class="w-5 h-5 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                    </svg>
                </div>
                <span class="text-slate-300 text-xs font-medium text-center">Manage Sites</span>
            </a>
            <a href="{{ path('app_mail_index') }}"
               class="flex flex-col items-center gap-2 p-4 bg-slate-700/50 hover:bg-slate-700 border border-slate-600 hover:border-cyan-600 rounded-xl transition-all group">
                <div class="w-10 h-10 rounded-lg bg-cyan-600/20 group-hover:bg-cyan-600/40 flex items-center justify-center transition-colors">
                    <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                    </svg>
                </div>
                <span class="text-slate-300 text-xs font-medium text-center">Manage Mail</span>
            </a>
        </div>
    </div>
</div>

{% endblock %}
